# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 깃에 올라가지 않는다.
# 지금은 아무 값 없이도 돈다 (빈 저장소로 시작 · OpenFreeMap 지도는 키가 필요 없음).
# 등록·평가·글은 DATABASE_URL 이 없으면 저장소 루트의 .data/ 폴더 파일(db.json)에 저장된다 (src/lib/data/db.ts). 지우면 빈 저장소로 다시 시작한다.

# DB (Neon, db/README.md). 아래 줄의 # 을 지우고 값을 채우면 파일 대신 DB 에 저장한다.
# Neon → Connect → 「Connection pooling」 을 켠 주소(호스트 이름에 -pooler)를 넣는다. 지역은 싱가포르(서울 · 도쿄는 없다).
# DATABASE_URL=postgresql://<계정>:<비밀번호>@ep-<이름>-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DB 는 빈 채로 시작한다. 실제 가게는 어드민 「후보 가져오기」로 넣는다 (db/README.md)
# DB 연결 개수. 비우면 이 컴퓨터의 Postgres 는 5, 바깥 DB(Neon) 는 1 (src/lib/data/pg.ts)
DATABASE_POOL=

# 저장 폴더를 바꿀 때 (시험용 복사본 등). 비우면 .data (Vercel 에서는 /tmp/ddy-data). E2E 는 .data-e2e 를 쓴다
DATA_DIR=
# 사진 저장 (11-20: Vercel Blob 비공개 저장소 — 임시 자리). 서버에서만 읽는다, NEXT_PUBLIC_ 을 붙이지 않는다 (src/lib/data/photos.ts).
# Vercel 에서는 Blob 저장소를 프로젝트에 이으면 BLOB_STORE_ID 가 저절로 들어오고 열쇠 없이 붙는다 → 아래 값을 넣지 않는다.
# 이 컴퓨터에서 Blob 으로 시험하려면 `vercel env pull` 로 받거나, 저장소를 이을 때 만든 읽기 · 쓰기 열쇠를 아래에 넣는다.
# 둘 다 없으면 저장 폴더(DATA_DIR)/photos 에 넣는다(로컬 개발 · E2E). Vercel 에서 없으면 사진 올리기를 거절한다 (/tmp 는 사라지므로).
# 사진 주소는 어느 쪽이든 /api/photos/<id> 그대로다. 무료 한도: 저장 1GB · 올리기 월 2,000회 (넘으면 30일 동안 못 쓴다)
BLOB_READ_WRITE_TOKEN=
# 기기·접속 위치를 해시로 남길 때 섞는 값. 개발·로컬 빌드에서는 비워도 되지만 Vercel 배포에서는 비어 있으면 서버가 시작하지 않는다.
# 아무도 모르는 긴 글자를 넣는다 (예: openssl rand -hex 32)
# Vercel 배포에서는 DATABASE_URL 이 비어 있어도 서버가 시작하지 않는다 (파일 저장은 /tmp 라 남지 않아서)
HASH_SALT=

# 배포 주소 (사이트맵·공유 링크). 도메인을 사면 바꾼다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 네이버 지도 (확대 방식 ①의 실제 지도, 기본. 주소 ?zoom=names 면 ②). 비우면 OpenFreeMap 임시 지도 (src/components/map/realMap.ts)
# 네이버 클라우드 콘솔 → Maps → Application → Dynamic Map 의 Client ID. Web 서비스 URL 에 http://localhost · http://127.0.0.1 · 배포 주소를 넣어야 인증된다
# (포트·경로 없이 호스트만. http://localhost:3000 처럼 포트를 붙이면 인증 실패 — 네이버 클라우드 Maps 문제 해결 안내)
# 빌드 때 코드에 박히는 값이라, 바꾼 뒤엔 개발 서버를 다시 켠다. Client Secret 은 필요 없다(넣지 않는다)
NEXT_PUBLIC_NAVER_MAP_KEY=

# 운영 어드민(/admin) 열쇠 (11-15). 비우면 이 컴퓨터의 개발 서버(pnpm dev)에서 127.0.0.1 · localhost 주소로만 열린다 (src/lib/admin/access.ts).
# production(pnpm build + start · Vercel)은 비어 있으면 늘 잠긴다 (11-18). DATABASE_URL 이 바깥 DB(Neon) 주소여도 열쇠가 필요하다.
# 배포나 같은 와이파이의 폰에서 열려면 팀만 아는 긴 글자를 넣고, /admin/login 에서 같은 글자로 들어간다.
ADMIN_KEY=
