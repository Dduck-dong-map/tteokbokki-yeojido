# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 깃에 올라가지 않는다.
# 지금은 아무 값 없이도 돈다 (예시 데이터 · OpenFreeMap 지도는 키가 필요 없음).
# 등록·평가·글은 DATABASE_URL 이 없으면 저장소 루트의 .data/ 폴더 파일(db.json)에 저장된다 (src/lib/data/db.ts). 지우면 예시 데이터로 다시 시작한다.

# 로컬 DB (도커, 11-08). pnpm db:up 으로 켠 뒤 아래 줄의 # 을 지우면 파일 대신 DB 에 저장한다 (db/README.md)
# DATABASE_URL=postgres://ddy:ddy_local@127.0.0.1:15432/tteok
# Supabase 로 옮기면 Connect → Transaction pooler 주소(포트 6543)를 넣는다. Direct connection(5432)은 Vercel 에서 안 붙는다.
# DATABASE_URL=postgres://postgres.<프로젝트ID>:<비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# DB 연결 개수. 비우면 이 컴퓨터 DB 는 5, 바깥 DB(Supabase) 는 1 (src/lib/data/pg.ts)
DATABASE_POOL=

# 저장 폴더를 바꿀 때 (시험용 복사본 등). 비우면 .data (Vercel 에서는 /tmp/ddy-data). E2E 는 .data-e2e 를 쓴다
DATA_DIR=
# 기기·접속 위치를 해시로 남길 때 섞는 값. 개발·로컬 빌드에서는 비워도 되지만 Vercel 배포에서는 비어 있으면 서버가 시작하지 않는다.
# 아무도 모르는 긴 글자를 넣는다 (예: openssl rand -hex 32)
HASH_SALT=

# 예시 데이터(가게 16곳 · 글 · 리스트). 실제 가게를 넣으면 off → 예시를 화면에서 숨기고(지우지 않음) 검색엔진을 연다. 비우면 예시를 보인다
# 빌드 때 코드에 박히는 값이라, 바꾼 뒤엔 개발 서버를 다시 켜거나 다시 빌드한다 (src/lib/data/db.ts SHOW_SAMPLES)
NEXT_PUBLIC_SAMPLE_DATA=

# 배포 주소 (사이트맵·공유 링크). 도메인을 사면 바꾼다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 네이버 지도 (확대 방식 ①의 실제 지도, 주소 ?zoom=real). 비우면 OpenFreeMap 임시 지도 (src/components/map/realMap.ts)
# 네이버 클라우드 콘솔 → Maps → Application → Dynamic Map 의 Client ID. Web 서비스 URL 에 http://localhost · http://127.0.0.1 · 배포 주소를 넣어야 인증된다
# (포트·경로 없이 호스트만. http://localhost:3000 처럼 포트를 붙이면 인증 실패 — 네이버 클라우드 Maps 문제 해결 안내)
# 빌드 때 코드에 박히는 값이라, 바꾼 뒤엔 개발 서버를 다시 켠다. Client Secret 은 필요 없다(넣지 않는다)
NEXT_PUBLIC_NAVER_MAP_KEY_ID=
