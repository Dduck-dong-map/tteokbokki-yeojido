# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 깃에 올라가지 않는다.
# 지금은 아무 값 없이도 돈다(예시 데이터 · OpenFreeMap 지도는 키가 필요 없음).
# 제보·평가는 web/.data/ 폴더의 파일에 저장된다(lib/data/db.ts). 지우면 예시 데이터로 다시 시작한다.

# 저장 폴더를 바꿀 때 (시험용 복사본 등). 비우면 web/.data
DATA_DIR=
# 기기·접속 위치를 해시로 남길 때 섞는 값. 배포 때는 아무도 모르는 긴 글자로 넣는다
HASH_SALT=

# 배포 주소 (사이트맵·공유 링크). 도메인을 사면 바꾼다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# M2 · Supabase (계정·키 발급은 사용자가 직접)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 않는다

# 지도 엔진을 네이버로 정하면 (네이버 클라우드 콘솔에서 발급, 대표 계정만 무료 이용량)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 제보 주소 검색 (행정안전부 도로명주소 API 승인키)
JUSO_API_KEY=
